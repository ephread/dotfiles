[color]
    ui = auto

[core]
    editor = vim
	excludesFile = ~/.gitignore

[alias]
    # Unstage the changes in a given file.
    unstage = reset HEAD --

    # View the current changes in the staging area.
    staged = diff --cached

    # Print the name of the current upstream tracking branch.
    upstream = !git config --get branch.$(git current-branch).remote || echo origin

    lol = log --graph --decorate --pretty=oneline --abbrev-commit
    lold = log --graph --pretty=format:\"%C(auto)%h%d%Creset %C(cyan)(%ci)%Creset %C(green)%cn <%ce>%Creset %s\"
    lola = log --graph --decorate --pretty=oneline --abbrev-commit --all

    pom = pull origin main

    st = status
    df = diff
    co = checkout
    ci = commit
    br = branch --format='%(HEAD) %(color:yellow)%(refname:short)%(color:reset) - %(contents:subject) %(color:green)(%(committerdate:relative)) [%(authorname)]' --sort=-committerdate
    ll = log --oneline
    last = log -1 HEAD --stat

    save = !git add -A && git commit -m 'chore: wip/savepoint'
    done = !git push origin HEAD

    fixup = !git log --oneline --decorate @{u} | fzy | awk '{ print $1 }' | xargs -I{} git commit --fixup={}

    snr = "!f() { \
        b=$(git rev-parse --abbrev-ref HEAD) && \
        git checkout main && \
        git pull && \
        git checkout \"$b\" \
        && git rebase main; \
    }; f"

    pm = "!f() { \
        b=$(git rev-parse --abbrev-ref HEAD) && \
        git checkout main && \
        git pull && \
        git checkout \"$b\"; \
    }; f"

    rnr = "!f() { \
        msg=$(git log -1 --pretty=%B) && \
        echo \"$msg\" > .git/.last_commit_msg && \
        git reset --soft HEAD~1 && \
        git stash save && \
        git pm && \
        git reset main --hard && \
        git stash pop && \
	git add . && \
        git commit -m \"$msg\"; \
    }; f"
	fd = "!f() { \\\n  remote_head=$(git symbolic-ref refs/remotes/origin/HEAD --short 2>/dev/null); \\\n  if [ -z \"$remote_head\" ]; then \\\n    echo \"Updating remote HEAD...\"; \\\n    git remote set-head origin --auto; \\\n    remote_head=$(git symbolic-ref refs/remotes/origin/HEAD --short); \\\n  fi; \\\n  default_branch=${remote_head#origin/}; \\\n  echo \"Fetching origin/$default_branch into local $default_branch...\"; \\\n  git fetch origin \"$default_branch:$default_branch\"; \\\n}; f"

[branch]
    autosetuprebase = always

[diff]
    tool = default-difftool

[difftool "default-difftool"]
    cmd = code --wait --diff $LOCAL $REMOTE

[merge]
    # Use the OS X graphical three-way merge tool for graphical merges.
    tool = code

[mergetool "code"]
    cmd = code --wait --merge $REMOTE $LOCAL $BASE $MERGED
    # Don't prompt before opening the merge tool.
    prompt = false
    # Don't keep backups of the merge tool inputs.
    keepBackup = false
    # Don't keep the merge tool temporary input/output files.
    keepTemporaries = false

[github]
    user = ephread
[push]
    default = simple
[credential]
    helper = osxkeychain
[init]
    defaultBranch = main
[commit]
	gpgsign = true
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[pull]
	rebase = true
