{
    "telemetry.enableTelemetry": false,
    "workbench.iconTheme": "material-icon-theme",
    "materialTheme.fixIconsRunning": false,
    "window.zoomLevel": 0,
    "editor.fontSize": 16,
    "editor.fontFamily": "Fira Code, Inconsolata, Menlo, Monaco, 'Courier New', monospace",
    "files.associations": {
        "*.dsa": "javascript"
    },

    "editor.wordWrapColumn": 100,
    "editor.rulers": [80, 100, 120],
    "editor.minimap.renderCharacters": false,
    "editor.renderWhitespace": "all",
    "gitlens.advanced.messages": {
        "suppressShowKeyBindingsNotice": true
    },
    "files.trimTrailingWhitespace": true,
    "editor.minimap.enabled": true,
    "typescript.updateImportsOnFileMove.enabled": "always",
    "gitlens.advanced.telemetry.enabled": false,
    "gitlens.codeLens.authors.enabled": false,
    "editor.codeLens": false,
    "breadcrumbs.enabled": true,
    "[javascript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.formatOnSave": false
    },
    "prettier.tslintIntegration": true,
    "[typescript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "workbench.colorTheme": "Palenight Theme",
    "javascript.updateImportsOnFileMove.enabled": "always",
    "debug.onTaskErrors": "debugAnyway",
    "editor.fontLigatures": true,
    "omnisharp.enableRoslynAnalyzers": true,
    "write-good.write-good-config": {},
    "[html]": {
        "editor.defaultFormatter": "HookyQR.beautify"
    },
    "workbench.editor.empty.hint": "hidden",
    "markdown.extension.toc.levels": "2..6",
    "[markdown]": {
        "editor.defaultFormatter": "DavidAnson.vscode-markdownlint"
    },
    "workbench.editor.tabActionUnpinVisibility": false,
    "C_Cpp.intelliSenseEngine": "disabled",
    "[cpp]": {
        "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd"
    },
    "[python]": {
        "editor.defaultFormatter": "ms-python.autopep8",
        "editor.formatOnSave": true
    },
    "git.openRepositoryInParentFolders": "always",
    "lldb.library": "/Library/Developer/CommandLineTools/Library/PrivateFrameworks/LLDB.framework/Versions/A/LLDB",
    "lldb.launch.expressions": "native",
    "[swift]": {
        "editor.formatOnSave": false
    },
    "swiftlint.configSearchPaths": [".swiftlint.yml"],
    "workbench.editorAssociations": {
        "*.copilotmd": "vscode.markdown.preview.editor",
        "*.svg": "default"
    },
    "[typescriptreact]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "github.copilot.nextEditSuggestions.enabled": true,
    "window.autoDetectColorScheme": true,
    "workbench.preferredDarkColorTheme": "Palenight Theme",
    "workbench.preferredLightColorTheme": "Night Owl Light",
    "explorer.confirmDelete": false,
    "python.analysis.typeCheckingMode": "standard",
    "[json]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "redhat.telemetry.enabled": true
}
