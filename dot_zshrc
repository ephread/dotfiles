# Environment and paths

eval "$(/opt/homebrew/bin/brew shellenv)"

# Keep PATH entries unique, with custom commands ahead of system commands.
typeset -U PATH path
path=(
  /opt/bin
  "$HOME/.local/bin"
  "$HOMEBREW_PREFIX/opt/gnu-getopt/bin"
  $path
  "$HOME/.lmstudio/bin"
)
export PATH

export GPG_TTY="$(tty)"

dev_caches() {
  local cache_root="/Volumes/Data SSD/Caches"

  if [[ -d "$cache_root" && -w "$cache_root" ]]; then
    export GRADLE_USER_HOME="$cache_root/gradle"
    export npm_config_cache="$cache_root/npm"
    export PLAYWRIGHT_BROWSERS_PATH="$cache_root/playwright"
    export CYPRESS_CACHE_FOLDER="$cache_root/cypress"
    export HOMEBREW_CACHE="$cache_root/homebrew"
  else
    export GRADLE_USER_HOME="$HOME/.gradle"
    export npm_config_cache="$HOME/.npm"
    export PLAYWRIGHT_BROWSERS_PATH="$HOME/Library/Caches/ms-playwright"
    export CYPRESS_CACHE_FOLDER="$HOME/Library/Caches/Cypress"
    export HOMEBREW_CACHE="$HOME/Library/Caches/Homebrew"
  fi

  mkdir -p "$CYPRESS_CACHE_FOLDER"
}

dev_caches

# Shell behavior and history

# no c-s/c-q output freezing
setopt noflowcontrol
# allow expansion in prompts
setopt prompt_subst
# this is default, but set for share_history
setopt append_history
# save each command's beginning timestamp and the duration to the history file
setopt extended_history
# display PID when suspending processes as well
setopt longlistjobs
# try to avoid the 'zsh: no matches found...'
setopt nonomatch
# report the status of backgrounds jobs immediately
setopt notify
# use zsh style word splitting
setopt noshwordsplit
# allow use of comments in interactive code
setopt interactivecomments

# Increase history sizes in memory and file
export HISTSIZE=50000
export SAVEHIST=50000

# Share history across all active tabs and write immediately
setopt share_history

# Completions

# Hash the entire command path before attempting completion.
setopt hash_list_all
# Complete at the cursor, including within a word.
setopt completeinword

autoload -U compinit && compinit
zmodload -i zsh/complist

zstyle ':completion:*' menu select

# Plugins

source "$(brew --prefix antidote)/share/antidote/antidote.zsh"
antidote load "${ZDOTDIR:-$HOME}/.zsh_plugins.txt"

# Tool integrations

eval "$(mise activate zsh)"
eval "$(atuin init zsh)"
eval "$(zoxide init zsh)"

# Functions and keybindings

# Chezmoi-managed external shell extensions.
for extension in "$HOME"/.shell/functions/*.zsh(N); do
  source "$extension"
done

jt() {
  worktree_jump "$(git rev-parse --show-toplevel)" "$@"
}

bindkey -M menuselect '^[[Z' reverse-menu-complete
bindkey '^[[1;3D' backward-word
bindkey '^[[1;3C' forward-word
bindkey '^[[H' beginning-of-line
bindkey '^[[F' end-of-line

# Prompt and terminal title

export STARSHIP_CONFIG="$HOME/.starship.toml"
eval "$(starship init zsh)"

update_terminal_title() {
  local title="${TTY_TAB_LABEL:-${PWD:t}}"
  print -Pn "\e]2;${title}\a"
}

autoload -Uz add-zsh-hook
add-zsh-hook precmd update_terminal_title
