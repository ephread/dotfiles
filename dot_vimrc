" Display syntax-aware colors when Vim has a matching syntax definition.
syntax enable

" Keep Vim's foreground, background, and ANSI colors under Ghostty's control.
" The default scheme leaves the Normal highlight unset, while regular terminal
" colors use Ghostty's palette.  Do not enable truecolor here: it would replace
" those palette colors with Vim's fixed RGB equivalents.
set notermguicolors
colorscheme default

" Mark preferred maximum line widths.
set colorcolumn=80,100,120

" Detect file types and enable their matching plugins and indentation rules.
filetype plugin indent on

" Keep modified buffers open when switching files, reload externally changed files,
" and preserve undo history across Vim sessions.
set hidden
set autoread
set undofile

" Use four spaces for indentation and make Backspace behave naturally.
set expandtab
set shiftwidth=4
set tabstop=4
set smartindent
set backspace=indent,eol,start

" Show conventional absolute line numbers and highlight the current line.
set number
set cursorline
set scrolloff=5
set signcolumn=yes

" Search as you type, ignoring case unless the search contains capital letters.
set ignorecase
set smartcase
set incsearch
set hlsearch

" Put new splits in predictable places.
set splitbelow
set splitright

" Enable mouse support and use the macOS system clipboard.
set mouse=a
set clipboard=unnamed

" Keep long lines on one screen line while editing code.
set nowrap

" Wrap Git commit messages at the conventional width and check their spelling.
autocmd FileType gitcommit setlocal spell textwidth=72
