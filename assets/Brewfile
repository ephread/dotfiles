# `brew bundle` evaluates Brewfiles as Ruby. The chezmoi bootstrap scripts set
# DOTFILES_BUNDLE_PHASE to install only the packages appropriate to that phase.
# Running this file directly without that variable installs every phase.

phase = ENV.fetch("DOTFILES_BUNDLE_PHASE", "all")
install_pre = ["pre", "all"].include?(phase)
install_post = ["post", "all"].include?(phase)

# Install xcodes before using it to install Xcode.
if install_pre
    brew 'xcodes'
end

# Every remaining package is installed only after the mainline Xcode release.
if install_post
    brew 'git'
    brew 'git-lfs'

    brew 'openssl@3'
    brew 'pkgconf'

    brew 'imagemagick'
    brew 'ffmpeg'

    brew 'coreutils'
    brew 'curl'
    brew 'mise'

    brew 'starship'
    brew 'antidote'
    brew 'fzy'
    tap 'chmouel/lazyworktree', 'https://github.com/chmouel/lazyworktree'
    cask 'lazyworktree'

    brew 'gh'
    brew 'aria2'

    brew 'mas'

    # Mobile and Apple development. SwiftLint is intentionally omitted: iOS
    # projects install the pinned version through Mint.
    brew 'apktool'
    brew 'bundletool'
    brew 'xcbeautify'
    tap 'getsentry/xcodebuildmcp'
    brew 'mobilebuildmcp'

    # CI and JVM development
    brew 'bitrise'
    brew 'circleci'
    brew 'maven'

    # General development and automation utilities
    brew 'go'
    brew 'gnupg'
    brew 'pinentry-mac'
    brew 'pandoc'
    brew 'tesseract'
    brew 'xmlstarlet'
    brew 'yt-dlp'
    brew 'vjeantet/tap/alerter'
    brew 'tbvdm/tap/sigtop'

    # Creative tooling
    brew 'fontforge'

    # Casks
    cask 'gpg-suite-no-mail'

    cask 'tuxera-ntfs'
    cask 'the-unarchiver'

    cask 'font-fira-code'

    cask '1password'
    cask '1password-cli'

    cask 'firefox'
    cask 'google-chrome'

    cask 'fork'
    cask 'visual-studio-code'

    cask 'vlc'
    cask 'iina'

    cask 'telegram'
    cask 'signal'
    cask 'slack'
    cask 'discord'
    cask 'zoom'

    cask 'sketch'
    cask 'figma'

    cask 'devtoys'

    # Development apps
    cask 'android-platform-tools'
    cask 'ghostty'
    cask 'swiftformat-for-xcode'
    cask 'temurin'

    # Creative and personal apps
    cask 'affinity-designer'
    cask 'affinity-photo'
    cask 'imageoptim'
    cask 'firefox@developer-edition'
    cask 'localsend'
    cask 'macdown'
    cask 'ngrok'
    cask 'notion'
    cask 'proxyman'
    cask 'qlmarkdown'

    # Mint installs and runs Swift packages and therefore requires Xcode.
    brew 'mint'
end
